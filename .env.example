# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Authentication & Client Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key

# Supabase Server-Only Secret (Never expose to client!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_service_role_key

# Database Connection Strings (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:password@localhost:5432/urban_flood_db
DIRECT_DATABASE_URL=postgresql://postgres:password@localhost:5432/urban_flood_db

# Map Provider API Key (Client-side)
NEXT_PUBLIC_MAP_PROVIDER_KEY=pk.example_map_provider_key

# Object Storage: Cloudflare R2 (Server-side)
R2_ACCOUNT_ID=example_r2_account_id
R2_ACCESS_KEY_ID=example_r2_access_key_id
R2_SECRET_ACCESS_KEY=example_r2_secret_access_key
R2_BUCKET_NAME=urban-flood-assets
R2_PUBLIC_URL=https://assets.flood-intel.example.com
